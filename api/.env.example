# Database Configuration (PostgreSQL - Aiven)
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=unicard-files
R2_PUBLIC_URL=https://your-r2-bucket.r2.dev

# Background Removal Service
BG_REMOVAL_URL=http://localhost:5000

# Server Configuration
PORT=3001
NODE_ENV=development

# Email Configuration (Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
EMAIL_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME=UniCraft Solutions

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Production Example:
# BG_REMOVAL_URL=https://your-railway-app.up.railway.app
# NODE_ENV=production
# FRONTEND_URL=https://your-school-portal.vercel.app
